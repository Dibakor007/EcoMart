# ==========================================
# Node.js & Vite Full-Stack .gitignore Template
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
jspm_packages/
web_modules/

# Build and Production Outputs
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# Environment and Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example

# Logs and Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Code Coverage
coverage/
.nyc_output/
.clover/
html-report/

# Editor and IDE Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary & Cache Directories
.eslintcache
.stylelintcache
.prettiercache
*.tmp
*.temp
.gemini/
